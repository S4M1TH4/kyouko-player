+/// Result captured on the output worker before any data callback. This is a
+/// local instrumentation extension; thread priority is a startup snapshot,
+/// not a claim about Windows' dynamic scheduler priority at every instant.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum OutputPromotion {
+    Disabled,
+    Mmcss,
+    Fallback { mmcss_error: String },
+    Failed { mmcss_error: String, fallback_error: String },
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct OutputWorkerStartup {
+    pub thread_id: u32,
+    pub thread_priority: Option<i32>,
+    pub promotion: OutputPromotion,
+}
+
+fn output_worker_startup(period_frames: FrameCount, sample_rate: SampleRate) -> OutputWorkerStartup {
+    #[cfg(feature = "realtime")]
+    let promotion = match audio_thread_priority::promote_current_thread_to_real_time(period_frames, sample_rate) {
+        Ok(_) => OutputPromotion::Mmcss,
+        Err(error) => {
+            let mmcss_error = error.to_string();
+            match unsafe { Threading::SetThreadPriority(Threading::GetCurrentThread(), Threading::THREAD_PRIORITY_TIME_CRITICAL) } {
+                Ok(()) => OutputPromotion::Fallback { mmcss_error },
+                Err(error) => OutputPromotion::Failed { mmcss_error, fallback_error: error.to_string() },
+            }
+        }
+    };
+    #[cfg(not(feature = "realtime"))]
+    let promotion = {
+        let _ = (period_frames, sample_rate);
+        OutputPromotion::Disabled
+    };
+    let priority = unsafe { Threading::GetThreadPriority(Threading::GetCurrentThread()) };
+    OutputWorkerStartup {
+        thread_id: unsafe { Threading::GetCurrentThreadId() },
+        thread_priority: (priority != i32::MAX).then_some(priority),
+        promotion,
+    }
+}
